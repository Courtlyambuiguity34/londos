# Render full-core template. No real credentials belong in this tracked file.
# Copy these entries into BOTH services' Render Environment settings.
# Fill every empty required value before enabling the core. Never upload .env.local.
# Runtime roles may use different DATABASE_URL credentials for the SAME database.
# Keep the same AUTH_SECRET and AUTH_BASE_URL on web and worker.
DEPLOY_MODE=render
NODE_ENV=production
LONDOS_CORE_ENABLED=true
LONDOS_DATA_SOURCE=database
# Enable after the real catalogue and canonical HTTPS domain are ready.
# See docs/SEARCH-INDEXING-AND-DOMAINS.md.
LONDOS_SEARCH_INDEXING=false
LONDOS_DATABASE_ENGINE=postgresql

# REQUIRED: provider's PostgreSQL URL, including its actual port and verified TLS.
DATABASE_URL=
# REQUIRED: a stable random secret of at least 32 characters. Generate once privately.
AUTH_SECRET=
# REQUIRED: exact HTTPS web origin, e.g. https://londos-web.onrender.com (no path).
AUTH_BASE_URL=
# Optional: omit this key for the initial single-origin deployment. The canonical
# AUTH_BASE_URL is already allowed. For separate PWA origins supply 1-3 exact HTTPS
# origins under the same registrable domain; never use a wildcard or a path.
# LONDOS_PWA_ORIGINS=https://mall.example.com,https://shop.example.com,https://admin.example.com

# REQUIRED: remote auth uses Brevo; local notification files are development only.
LONDOS_LOCAL_ADAPTERS=false
LONDOS_EMAIL_PROVIDER=brevo
LONDOS_BREVO_API_KEY=
LONDOS_EMAIL_FROM=
LONDOS_EMAIL_FROM_NAME=Londos
LONDOS_EMAIL_MAX_PER_HOUR=250
LONDOS_EMAIL_MAX_PER_DAY=250
LONDOS_MONTHLY_REPORTS_ENABLED=false

# Optional services: absent credentials are fine while their flags remain false.
# MongoDB/Cloudinary are manual public copies, not the canonical data store.
LONDOS_MONGODB_ENABLED=false
LONDOS_MONGODB_MIGRATION_ENABLED=false
LONDOS_CLOUDINARY_ENABLED=false
LONDOS_REDIS_ENABLED=false
# MONGODB_URL=
# MONGODB_DATABASE=londos_public_copy
# CLOUDINARY_URL=
# REDIS_URL=

# Deterministic shop building needs no AI keys. Enable remote AI only after its
# model, budget and provider checks; see docs/AI-ENVIRONMENT.md for those settings.
LONDOS_AI_REMOTE=false
# Optional AI credentials/models/rates: leave omitted until approved and verified.
# GEMINI_API_KEY_1=
# LONDOS_AI_GEMINI_SLOT=1
# LONDOS_AI_GEMINI_MODEL=
# LONDOS_AI_GEMINI_INPUT_MICROUSD_PER_MILLION=
# LONDOS_AI_GEMINI_OUTPUT_MICROUSD_PER_MILLION=
# LONDOS_OPENAI_API_KEY=
# LONDOS_AI_OPENAI_MODEL=
# LONDOS_AI_OPENAI_INPUT_MICROUSD_PER_MILLION=
# LONDOS_AI_OPENAI_OUTPUT_MICROUSD_PER_MILLION=
# LONDOS_AI_DAILY_COST_MICROUSD=1000000
# LONDOS_AI_AUTH_FAILOVER=false
# LONDOS_AI_ALLOW_OPENAI_FALLBACK=false
LONDOS_PILOT_ANALYTICS=false
LONDOS_PRIVACY_ERASURE=false

# Render supplies PORT to the web process; leave it out of imported settings.
# If PostgreSQL requires a custom CA, upload its PUBLIC certificate as a Render
# Secret File and point this setting to it. Never disable certificate validation.
# LONDOS_RUNTIME_CA_FILE=/etc/secrets/postgresql-ca.pem
