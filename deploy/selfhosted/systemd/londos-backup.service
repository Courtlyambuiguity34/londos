[Unit]
Description=Londos nightly PostgreSQL backup
After=postgresql.service

[Service]
Type=oneshot
User=londos
Group=londos
WorkingDirectory=/opt/londos/current
EnvironmentFile=/etc/londos/londos.env
ExecStart=/opt/londos/current/deploy/selfhosted/nightly-backup.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/londos/current/.local /mnt/londos-backups
