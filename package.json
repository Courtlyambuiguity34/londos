{
  "name": "londos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Londos digital mall — staged implementation",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "postbuild": "node scripts/package-standalone.mjs && node scripts/build-worker.mjs",
    "start": "node scripts/start.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write src tests scripts *.json *.ts *.mjs",
    "format:check": "prettier --check src tests scripts *.json *.ts *.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:docs": "node scripts/check-docs.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run check:docs",
    "db:local": "node scripts/dev-database.mjs up",
    "db:stop": "node scripts/dev-database.mjs stop",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:generate": "tsx scripts/generate.ts",
    "worker": "node dist/worker.mjs",
    "test:integration": "tsx scripts/integration-tests.ts",
    "test:e2e:core": "tsx scripts/e2e-core.ts",
    "worker:dev": "tsx src/worker/main.ts",
    "check:bundle-secrets": "node scripts/check-bundle-secrets.mjs"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/pg": "8.16.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "otplib": "13.5.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
