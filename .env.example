# Public browsing uses labeled fictional fixtures; X1 private services are opt-in.
# For Render's database-backed web + worker, use deploy/.env.example. It contains
# every required key with empty secret values ready to fill in Render Environment.
# This root example preserves the credential-free local preview defaults.
# Do not copy your local development DATABASE_URL or generated accounts to Render.
LONDOS_DATA_SOURCE=fixtures
# Enable only for a real published catalogue on the verified HTTPS AUTH_BASE_URL.
# See docs/SEARCH-INDEXING-AND-DOMAINS.md. Preview/local sites stay noindex.
LONDOS_SEARCH_INDEXING=false
# Render + hosted PostgreSQL is the default. Change only environment values to
# select an owned server; selfhosted production binds the web process to loopback.
DEPLOY_MODE=render
# npm run db:local creates ignored .env.local with random local credentials.
# Windows uses native PostgreSQL; macOS/Linux use the pinned PostgreSQL container.
# DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@127.0.0.1:54329/londos_development
# AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# AUTH_BASE_URL=http://127.0.0.1:3000
# For Render/owned-server mode use the one exact public HTTPS origin, e.g.
# AUTH_BASE_URL=https://mall.example
# Optional comma-separated allowlist for the Mall, Shopkeeper and Landlord PWA
# origins. At most three unique HTTPS origins; cross-site requests remain denied.
# LONDOS_PWA_ORIGINS=https://mall.example,https://shop.example,https://admin.example
# Render's internal PORT may differ; local mode requires PORT to match this URL's port.
# Browsers/PWAs receive neither DATABASE_URL nor MONGODB_URL; all data access uses the Londos API.
# LONDOS_LOCAL_ADAPTERS=true
# LONDOS_CORE_ENABLED=false explicitly runs only the public fixture preview.
# Remote authentication requires explicitly configured Brevo; missing configuration fails closed.
# LONDOS_EMAIL_PROVIDER=brevo
# LONDOS_BREVO_API_KEY=REPLACE_IN_SECURE_SETTINGS
# LONDOS_EMAIL_FROM=REPLACE_WITH_VERIFIED_SENDER_EMAIL
# LONDOS_EMAIL_FROM_NAME=Londos
# Conservative application caps; set both at or below the current provider/plan limits.
# Brevo Free was checked on 2026-10-10 and documented 300 sends/day.
LONDOS_EMAIL_MAX_PER_HOUR=250
LONDOS_EMAIL_MAX_PER_DAY=250
# Monthly shop reports are opt-in until analytics/privacy policy is approved.
LONDOS_MONTHLY_REPORTS_ENABLED=false
# Local adapters always use the private sink, even when Brevo is configured.
# Use npm run email:verify for read-only account/sender checks; no email is sent.
# PostgreSQL remains canonical. Optional services never migrate or replace it.
LONDOS_DATABASE_ENGINE=postgresql
LONDOS_MONGODB_ENABLED=false
LONDOS_MONGODB_MIGRATION_ENABLED=false
LONDOS_REDIS_ENABLED=false
LONDOS_CLOUDINARY_ENABLED=false
# Set private connection credentials only when manually enabling a service.
# MONGODB_URL=mongodb+srv://USER:PASSWORD@YOUR_CLUSTER.mongodb.net/londos_public_copy
# MONGODB_URI is a legacy alias; different values under both names fail closed.
# MONGODB_DATABASE=londos_public_copy (required when URL has no database; match URI if both set)
# REDIS_URL=rediss://USER:PASSWORD@YOUR_REDIS_HOST:6379
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# MongoDB verification needs no Cloudinary/Redis; public image copies require Cloudinary=true.
# npm run mongo:verify uses temporary identified data and confirms cleanup; no migration.
# Account/rent/audit data is never copied. Redis stays optional, including for subscriptions.
# Redis supplies a connection check; it does not yet replace app caches or job queues.
# SQLite is not a supported canonical database for the current SQL/transaction contracts.
# Keep all credentials server-side; never use NEXT_PUBLIC_ for a secret.
# Optional fictional local analytics in database mode; live tracking is disabled.
# LONDOS_PILOT_ANALYTICS=true
# Retention: 7-90 UTC calendar days, including today.
# LONDOS_PILOT_RETENTION_DAYS=30

# Optional reviewed primary-data erasure for fictional local records only.
# LONDOS_PRIVACY_ERASURE=true

# Conversational design: deterministic supported edits need no external provider.
# Remote calls default off and require per-request merchant consent.
# LONDOS_AI_REMOTE=true
# Configure secrets through the deployment secret facility, never in tracked files.
# GEMINI_API_KEY_1=REPLACE_IN_SECURE_SETTINGS
# Slots 2-5 are optional; select one explicitly, never cycle for quota/billing.
# GEMINI_API_KEY_2=REPLACE_IN_SECURE_SETTINGS
# GEMINI_API_KEY_3=REPLACE_IN_SECURE_SETTINGS
# GEMINI_API_KEY_4=REPLACE_IN_SECURE_SETTINGS
# GEMINI_API_KEY_5=REPLACE_IN_SECURE_SETTINGS
# LONDOS_AI_GEMINI_SLOT=1
# LONDOS_AI_GEMINI_MODEL=REPLACE_WITH_VERIFIED_GEMINI_MODEL
# Managed cloud mapping for the reserved OPENAI_API_KEY name:
# LONDOS_OPENAI_API_KEY=REPLACE_IN_SECURE_SETTINGS
# LONDOS_AI_OPENAI_MODEL=REPLACE_WITH_VERIFIED_OPENAI_MODEL
# Direct deployments also support OPENAI_API_KEY when the platform permits it.
# Required explicit price estimates: integer USD micro-units per million tokens.
# LONDOS_AI_GEMINI_INPUT_MICROUSD_PER_MILLION=REPLACE_WITH_APPROVED_INTEGER_RATE
# LONDOS_AI_GEMINI_OUTPUT_MICROUSD_PER_MILLION=REPLACE_WITH_APPROVED_INTEGER_RATE
# LONDOS_AI_OPENAI_INPUT_MICROUSD_PER_MILLION=REPLACE_WITH_APPROVED_INTEGER_RATE
# LONDOS_AI_OPENAI_OUTPUT_MICROUSD_PER_MILLION=REPLACE_WITH_APPROVED_INTEGER_RATE
# Daily configured estimate reservation limit: USD 1.00, not actual billing.
# LONDOS_AI_DAILY_COST_MICROUSD=1000000
# Optional authentication-only spare credential; never quota/rate-limit rotation.
# LONDOS_AI_AUTH_FAILOVER=false
# Optional OpenAI outage fallback; quota/rate-limit conditions never use fallback.
# LONDOS_AI_ALLOW_OPENAI_FALLBACK=false
# Node 24 native fetch must retain the configured proxy/CA trust in managed cloud.
# NODE_USE_ENV_PROXY=1

# Optional public policy contact (an address you monitor).
# LONDOS_SUPPORT_EMAIL=
# Optional ONE-TIME permanent accounts. Set all three keys for each requested role.
# Passwords: unique, private, 20-128 characters. Never commit filled values.
# Apply migrations before startup. Email verification and landlord MFA are required.
# Remove these keys after successful provisioning; restarts never reset accounts.
# LONDOS_BOOTSTRAP_ADMIN_NAME=
# LONDOS_BOOTSTRAP_ADMIN_EMAIL=
# LONDOS_BOOTSTRAP_ADMIN_PASSWORD=
# LONDOS_BOOTSTRAP_SHOPKEEPER_NAME=
# LONDOS_BOOTSTRAP_SHOPKEEPER_EMAIL=
# LONDOS_BOOTSTRAP_SHOPKEEPER_PASSWORD=
