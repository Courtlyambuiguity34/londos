# Public browsing uses labeled fictional fixtures; X1 private services are opt-in.
LONDOS_DATA_SOURCE=fixtures
# npm run db:local creates ignored .env.local with random local credentials.
# DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@127.0.0.1:54329/londos_development
# AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# AUTH_BASE_URL=http://127.0.0.1:3000
# LONDOS_LOCAL_ADAPTERS=true
# LONDOS_CORE_ENABLED=false explicitly runs only the public fixture preview.
# Remote/live authentication is blocked until real notification adapters exist.
# Keep all credentials server-side; never use NEXT_PUBLIC_ for a secret.

# Optional fictional local analytics in database mode; live tracking is disabled.
# LONDOS_PILOT_ANALYTICS=true
# Retention: 7-90 UTC calendar days, including today.
# LONDOS_PILOT_RETENTION_DAYS=30

# Optional reviewed primary-data erasure for fictional local records only.
# LONDOS_PRIVACY_ERASURE=true
