# Public browsing uses labeled fictional fixtures; X1 private services are opt-in.
LONDOS_DATA_SOURCE=fixtures
# npm run db:local creates ignored .env.local with random local credentials.
# DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@127.0.0.1:54329/londos_development
# AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# AUTH_BASE_URL=http://127.0.0.1:3000
# LONDOS_LOCAL_ADAPTERS=true
# LONDOS_CORE_ENABLED=false explicitly runs only the public fixture preview.
# Remote/live authentication is blocked until real notification adapters exist.
# Keep all credentials server-side; never use NEXT_PUBLIC_ for a secret.


# Optional external service connection strings. Keep real values in deployment secrets only.
# Reserved for reviewed MongoDB-backed features; no runtime dependency is implied by this placeholder.
# MONGODB_URL=mongodb+srv://REPLACE_USER:REPLACE_PASSWORD@REPLACE_CLUSTER/REPLACE_DATABASE
# Reserved for reviewed Redis-backed cache/queue/rate-limit features; prefer TLS (rediss://) remotely.
# REDIS_URL=rediss://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:REPLACE_PORT

# Optional fictional local analytics in database mode; live tracking is disabled.
# LONDOS_PILOT_ANALYTICS=true
# Retention: 7-90 UTC calendar days, including today.
# LONDOS_PILOT_RETENTION_DAYS=30

# Optional reviewed primary-data erasure for fictional local records only.
# LONDOS_PRIVACY_ERASURE=true

# Conversational design: deterministic supported edits need no external provider.
# Remote calls default off and require per-request merchant consent.
# LONDOS_AI_REMOTE=true
# Configure secrets through the deployment secret facility, never in tracked files.
# GEMINI_API_KEY_1=REPLACE_IN_SECURE_SETTINGS
# Slots 2-5 are optional; select one explicitly, never cycle for quota/billing.
# GEMINI_API_KEY_2=REPLACE_IN_SECURE_SETTINGS
# GEMINI_API_KEY_3=REPLACE_IN_SECURE_SETTINGS
# GEMINI_API_KEY_4=REPLACE_IN_SECURE_SETTINGS
# GEMINI_API_KEY_5=REPLACE_IN_SECURE_SETTINGS
# LONDOS_AI_GEMINI_SLOT=1
# LONDOS_AI_GEMINI_MODEL=REPLACE_WITH_VERIFIED_GEMINI_MODEL
# Managed cloud mapping for the reserved OPENAI_API_KEY name:
# LONDOS_OPENAI_API_KEY=REPLACE_IN_SECURE_SETTINGS
# LONDOS_AI_OPENAI_MODEL=REPLACE_WITH_VERIFIED_OPENAI_MODEL
# Direct deployments also support OPENAI_API_KEY when the platform permits it.
# Required explicit price estimates: integer USD micro-units per million tokens.
# LONDOS_AI_GEMINI_INPUT_MICROUSD_PER_MILLION=REPLACE_WITH_APPROVED_INTEGER_RATE
# LONDOS_AI_GEMINI_OUTPUT_MICROUSD_PER_MILLION=REPLACE_WITH_APPROVED_INTEGER_RATE
# LONDOS_AI_OPENAI_INPUT_MICROUSD_PER_MILLION=REPLACE_WITH_APPROVED_INTEGER_RATE
# LONDOS_AI_OPENAI_OUTPUT_MICROUSD_PER_MILLION=REPLACE_WITH_APPROVED_INTEGER_RATE
# Daily configured estimate reservation limit: USD 1.00, not actual billing.
# LONDOS_AI_DAILY_COST_MICROUSD=1000000
# Optional authentication-only spare credential; never quota/rate-limit rotation.
# LONDOS_AI_AUTH_FAILOVER=false
# Optional OpenAI outage fallback; quota/rate-limit conditions never use fallback.
# LONDOS_AI_ALLOW_OPENAI_FALLBACK=false
# Node 24 native fetch must retain the configured proxy/CA trust in managed cloud.
# NODE_USE_ENV_PROXY=1
